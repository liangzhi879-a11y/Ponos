{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevKit versions ledger",
  "type": "object",
  "required": ["version", "lines", "contracts", "skills", "skillsLock", "commonTools"],
  "properties": {
    "version": { "const": 1 },
    "generatedBy": { "type": "string" },
    "exclude": { "type": "array", "items": { "type": "object", "required": ["file", "id", "reason"] } },
    "history": {
      "type": "object",
      "required": ["baselineCount", "records"],
      "properties": {
        "baselineCount": { "type": "integer", "minimum": 0 },
        "commonToolsBaseline": { "type": "integer", "minimum": 0 },
        "records": {
          "type": "array",
          "items": { "type": "object", "required": ["key", "from", "to", "at"], "properties": {
            "key": { "type": "string" }, "from": {}, "to": {}, "at": { "type": "string" }, "reason": { "type": "string" } } }
        }
      }
    },
    "lines": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "contracts": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "skills": { "type": "array", "items": { "type": "object", "required": ["id", "file"] } },
    "skillsLock": { "type": "object", "required": ["source", "field", "ids"],
      "properties": { "source": { "const": "skills-lock.json" }, "field": { "const": "computedHash" },
        "ids": { "type": "array", "items": { "type": "string" } } } },
    "commonTools": {
      "type": "object",
      "required": ["baseline", "entries"],
      "properties": {
        "baseline": { "type": "array", "items": { "type": "string" } },
        "addedSinceBaseline": { "type": "array", "items": { "type": "string" } },
        "entries": { "type": "array", "items": { "type": "object", "required": ["file", "versionSource"] } }
      }
    },
    "channels": {
      "type": "object",
      "required": ["snapshotAt", "routes", "routePrefixes", "wsOut", "wsIn", "ipc", "tools", "staticToolCount", "toolSources", "excluded"],
      "properties": {
        "snapshotAt": { "type": "string" },
        "routes": { "type": "object", "description": "只存语义键 `<METHOD> <path>` → null；绝不存 file:line" },
        "routePrefixes": { "type": "object", "description": "前缀命名空间 → {dynamic, segments, suffixes, childCount}" },
        "wsOut": { "type": "array", "items": { "type": "string" } },
        "wsIn": { "type": "array", "items": { "type": "string" } },
        "ipc": { "type": "object", "required": ["invoke", "handle", "send", "on", "push"],
          "properties": { "invoke": { "type": "array" }, "handle": { "type": "array" }, "send": { "type": "array" },
            "on": { "type": "array" }, "push": { "type": "array" } } },
        "tools": { "type": "object", "description": "工具名 → 8hex 结构指纹（description 散文不入指纹）" },
        "staticToolCount": { "type": "integer", "minimum": 0 },
        "toolSources": { "type": "object", "description": "动态/派生工具来源逐条登记（present:false 表示「提取不到」，不是「不存在」）" },
        "excluded": { "type": "array", "items": { "type": "object", "required": ["kind", "literal", "reason"] } },
        "scopeCount": { "type": "integer", "minimum": 0, "description": "人工维护的 scope 组数封顶值（sync 不得改写）" },
        "scopeRedCount": { "type": "integer", "minimum": 0, "description": "人工维护的 scope 键数封顶值（sync 不得改写）" },
        "history": { "type": "object" }
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "value", "file", "locator"],
      "properties": {
        "id": { "type": "string" }, "value": {}, "valueType": { "type": "string" },
        "file": { "type": "string" }, "line": { "type": "integer" },
        "locator": { "type": "object", "required": ["kind"] },
        "kind": { "type": "string" }, "note": { "type": "string" },
        "migrationNote": { "type": "string" },
        "consumers": { "type": "array", "items": { "type": "string" } },
        "manual": { "type": "boolean" }
      }
    }
  }
}
