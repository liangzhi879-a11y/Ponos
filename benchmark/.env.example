# YFW-turbo 横向评估 —— LLM API 配置模板
# 复制为 benchmark/.env 后填写（.env 已被 gitignore，不会提交）
# 进程 env 优先：若系统环境已设置同名变量，以系统值为准

# 主密钥（缺省回退 ANTHROPIC_AUTH_TOKEN / DEEPSEEK_API_KEY）
# 各 agent 实际使用：yfw/claude → ANTHROPIC_AUTH_TOKEN；pi/deepseek → DEEPSEEK_API_KEY
LLM_API_KEY=sk-xxxx

# 默认模型（缺省 deepseek-v4-flash）
LLM_MODEL=deepseek-v4-flash

# DeepSeek 兼容端点（yfw/claude 经 ANTHROPIC_BASE_URL 走它，缺省则用官方端点）
LLM_BASE_URL=https://api.deepseek.com/anthropic
