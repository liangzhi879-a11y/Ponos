    ".rar": { "description": "RAR压缩包", "primary_library": "archive_extractor.py（需系统安装unrar）", "extract": { "function": "archive_extractor.py", "notes": "需系统PATH中有unrar.exe" } },
    ".7z": { "description": "7z压缩包", "primary_library": "archive_extractor.py（需py7zr）", "extract": { "function": "archive_extractor.py", "notes": "pip install py7zr（按需）" } }
  },

  "task_based_recommendations": {
    "生成核心表格（RD/PS/IP/TOAI/成果转化）": {
      "primary": "generate_tables_from_template.py",
      "library": "openpyxl",
      "command": "python generate_tables_from_template.py --template <template.xlsx> --output <output.xlsx> --data <data.json>",
      "validate": "python validate_tables.py --dir <output_dir> --project-root <root>",
      "notes": "必须从模板复制以保留样式，禁止从头创建"
    },
    "生成资料收集清单": {
      "primary": "generate_checklist.py",
      "library": "python-docx",
      "command": "python generate_checklist.py --output <output.docx> --data <data.json>"
    },
    "发票匹配PS产品": {
      "primary": "invoice_ps_matcher.py",
      "library": "openpyxl + PyMuPDF",
      "command": "python invoice_ps_matcher.py --application-pdf <申请书.pdf> --invoices <发票.xlsx>",
      "validate": "python validate_invoice_ps.py --dir <dir>"
    },
    "RD-IP-PS三角映射": {
      "primary": "rd_ip_ps_matching.py",
      "command": "python rd_ip_ps_matching.py --project-root <root>"
    },
    "成果转化材料日期合规校验": {
      "primary": "year_compliance_checker.py",
      "library": "openpyxl + PyMuPDF + PaddleOCR",
      "command": "python year_compliance_checker.py --apply-year <年份> --check-dir <成果目录> --achievement-table <转化表.xlsx>",
      "notes": "依据EXP-2026-07-17-001，5条强制规则：年份硬过滤/同年配对/测试报告不跨年/专利证书优先/文件名年份校验；含OCR fallback支持扫描件"
    },
    "成果转化证明材料PDF生成": {
      "primary": "generate_achievement_proofs.py",
      "library": "openpyxl + PyPDF2 + Pillow",
      "command": "python generate_achievement_proofs.py organize --achievement-table <转化表.xlsx> --materials-dir <材料目录> --ip-dir <IP证书目录> --output-dir <最终版本>",
      "notes": "三模式(preview/organize/auto-scan)。v1.36.0新增。预览确认后合并IP证书+合同+发票+产品证明为单个PDF。超2MB自动告警压缩指令。"
    },
    "单文件年份提取（调试）": {
      "primary": "year_compliance_checker.py",
      "command": "python year_compliance_checker.py --extract-year --file <文件>",
      "notes": "支持HXS编码/dzfp时间戳/通用日期/纯年份，辅以PDF内容+OCR交叉验证"
    },
    "扫描件PDF识别": {
      "primary": "ocr_engine.py",
      "library": "RapidOCR (PP-OCRv4 via ONNX Runtime)",
      "command": "python ocr_engine.py ocr --file <path> --project <project>",
      "notes": "智能检测+OCR，结果缓存到.trae/ocr_cache/{project}/{md5}.json，agent可重复读取"
    },
    "扫描件检测": {
      "primary": "doc_toolkit.py detect-scan",
      "library": "PyMuPDF（图片占比分析）",
      "command": "python doc_toolkit.py detect-scan --file <path>",
      "notes": "判定规则：文本层<50字符 OR 图片占比>80%"
    },
    "合同字段提取": {
      "primary": "contract_invoice_extractor.py",
      "library": "RapidOCR + 正则",
      "command": "python contract_invoice_extractor.py extract --file <合同.pdf> --output-dir <dir>",
      "notes": "提取甲乙方/签订日期/合同金额/合同编号/标的物，JSON+Excel双输出"
    },
    "发票字段提取": {
      "primary": "contract_invoice_extractor.py",
      "library": "RapidOCR + 正则",
      "command": "python contract_invoice_extractor.py extract --file <发票.pdf> --output-dir <dir>",
      "notes": "提取发票号/开票日期/购销方/货物明细/金额/税额/价税合计，JSON+Excel双输出"
    },
    "批量合同发票提取": {
      "primary": "contract_invoice_extractor.py batch",
      "library": "RapidOCR + 正则",
      "command": "python contract_invoice_extractor.py batch --dir <目录> --output-dir <结果目录>",
      "notes": "批量处理目录下所有PDF，自动检测文档类型并提取字段"
    },
    "OCR缓存查询": {
      "primary": "ocr_engine.py cache-list",
      "command": "python ocr_engine.py cache-list --project <project>",
      "notes": "查询项目的OCR缓存索引，避免重复OCR"
    },
    "输出文档版本管理": {
      "primary": "output_version_manager.py",
      "command": "python output_version_manager.py backup --file <输出文件> --skill <技能名>",
      "notes": "技能产出新文档前调用，自动将上一版本备份到.trae/output_backup/{skill}/，规定目录仅保留最新版本"
    },
    "目录清理（过程版本移入备份）": {
      "primary": "output_version_manager.py cleanup",
      "command": "python output_version_manager.py cleanup --dir <目录> --skill <技能名>",
      "notes": "扫描目录中_v1/_backup/_draft等过程版本文件，移入备份文件夹"
    },
    "专审报告核对": {
