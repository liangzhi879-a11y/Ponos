{
  "_comment": "gxtz技能系统预置技术栈决策表 - agent处理文件时直接查表，无需尝试不同方案",
  "_usage": "agent调用 doc_toolkit.py info <file> 时返回对应条目；或直接读取本文件按扩展名查找",
  "version": "2.0",
  "updated_at": "2026-07-17",

  "file_type_handlers": {
    ".xlsx": {
      "description": "Excel 2007+ 工作簿（核心表格、发票明细、人员信息）",
      "primary_library": "openpyxl",
      "library_install": "pip install openpyxl",
      "read": {
        "function": "openpyxl.load_workbook",
        "example": "wb = openpyxl.load_workbook(path, data_only=True); ws = wb.active; cell = ws['A1'].value",
        "toolkit_command": "python doc_toolkit.py read --file <path> --format xlsx"
      },
      "write": {
        "function": "openpyxl.Workbook",
        "example": "wb = openpyxl.Workbook(); ws = wb.active; ws['A1'] = 'value'; wb.save(path)",
        "toolkit_command": "python doc_toolkit.py write --file <path> --format xlsx --data <json>"
      },
      "template_copy": {
        "function": "openpyxl.load_workbook + copy",
        "toolkit_command": "python generate_tables_from_template.py --template <template> --output <output> --data <data.json>",
        "notes": "核心表格生成必须使用此脚本，保留模板样式"
      },
      "validate": {
        "function": "validate_tables.py",
        "toolkit_command": "python validate_tables.py --dir <output_dir> --project-root <root>",
        "notes": "5张核心表格对齐校验"
      },
      "common_scenarios": {
        "读取发票明细": "openpyxl.load_workbook(data_only=True) 逐行读取",
        "生成核心表格": "generate_tables_from_template.py（模板写死，保留样式）",
        "校验表格对齐": "validate_tables.py（对照00高新模板）"
      }
    },

    ".xls": {
      "description": "Excel 97-2003 旧版工作簿（部分历史资料）",
      "primary_library": "xlrd",
      "fallback_library": "openpyxl（仅支持只读，可能丢失格式）",
      "library_install": "pip install xlrd",
      "read": {
        "function": "xlrd.open_workbook",
        "example": "wb = xlrd.open_workbook(path); ws = wb.sheet_by_index(0); cell = ws.cell_value(0, 0)",
        "toolkit_command": "python doc_toolkit.py read --file <path> --format xls"
      },
      "write": {
        "function": "xlwt.Workbook（仅 .xls 格式写入）",
        "alternative": "转换为 .xlsx 后用 openpyxl 写入（推荐）",
        "toolkit_command": "python doc_toolkit.py convert --input <path> --to xlsx"
      },
      "common_scenarios": {
        "读取旧版RD/PS名称表": "xlrd.open_workbook 读取",
        "转换为xlsx处理": "doc_toolkit.py convert --to xlsx（推荐升级格式）"
      }
    },

    ".docx": {
      "description": "Word 2007+ 文档（立项书、清单、制度材料）",
      "primary_library": "python-docx",
      "library_install": "pip install python-docx",
      "read": {
        "function": "docx.Document",
        "example": "doc = docx.Document(path); for p in doc.paragraphs: print(p.text); for t in doc.tables: ...",
        "toolkit_command": "python doc_toolkit.py read --file <path> --format docx"
      },
      "write": {
        "function": "docx.Document + save",
        "example": "doc = docx.Document(); doc.add_paragraph('text'); doc.save(path)",
        "toolkit_command": "python doc_toolkit.py write --file <path> --format docx --data <json>"
      },
      "generate_from_template": {
        "function": "generate_checklist.py",
        "toolkit_command": "python generate_checklist.py --output <path> --data <data.json>",
        "notes": "资料收集清单生成（保留标准格式）"
      },
      "validate": {
        "function": "validate_rd_report.py / validate_management.py",
        "toolkit_command": "python validate_rd_report.py --dir <dir> --project-root <root>"
      },
      "common_scenarios": {
        "读取立项书内容": "docx.Document() 遍历 paragraphs 和 tables",
        "生成资料清单": "generate_checklist.py（标准格式）",
        "字数统计": "sum(len(p.text) for p in doc.paragraphs)",
        "对比两份docx": "python compare_docx.py <file1> <file2>"
      }
    },

    ".doc": {
      "description": "Word 97-2003 旧版文档（21个RD立项报告模板、政策文件）",
      "primary_library": "pywin32 (win32com)",
      "fallback_library": "LibreOffice 转换（非 Windows 平台）",
      "library_install": "pip install pywin32",
      "platform": "windows",
      "read": {
        "function": "win32com.client.Dispatch('Word.Application')",
        "example": "word = win32com.client.Dispatch('Word.Application'); doc = word.Documents.Open(path); text = doc.Content.Text",
        "toolkit_command": "python doc_toolkit.py read --file <path> --format doc"
      },
      "convert_to_docx": {
        "function": "win32com + SaveAs",
        "example": "doc.SaveAs(new_path, FileFormat=16)  # 16 = wdFormatXMLDocument (.docx)",
        "toolkit_command": "python doc_toolkit.py convert --input <path> --to docx",
        "notes": "转换后用 python-docx 处理，效率更高"
      },
      "common_scenarios": {
        "读取RD立项模板": "先转换为docx，再用python-docx处理",
        "批量转换21个模板": "doc_toolkit.py convert-dir --input <dir> --to docx"
      }
    },

    ".pdf": {
      "description": "PDF文档（申请书、审计报告、证书扫描件、发票）",
      "primary_library": "PyMuPDF (fitz)",
      "secondary_libraries": {
        "text_extraction": "pdfplumber",
        "split_merge": "PyPDF2",
        "image_extraction": "Pillow (PIL)",
        "ocr": "RapidOCR (PP-OCRv4 via ONNX Runtime)"
      },
      "library_install": "pip install PyMuPDF pdfplumber PyPDF2 Pillow",
      "ocr": {
        "description": "扫描件PDF的OCR识别（中文，识别率>95%）",
        "primary_library": "RapidOCR (基于ONNX Runtime，无Windows兼容性问题)",
        "library_install": "pip install rapidocr-onnxruntime",
        "detect_scanned": {
          "function": "ocr_engine.detect_scanned_pdf",
          "toolkit_command": "python doc_toolkit.py detect-scan --file <path>",
          "notes": "判定规则：文本层<50字符 OR 图片占比>80%"
        },
        "ocr_text": {
          "function": "ocr_engine.ocr_pdf",
          "toolkit_command": "python doc_toolkit.py read --file <path> --format pdf --mode ocr --project <project>",
          "notes": "结果缓存到.trae/ocr_cache/{project}/{md5}.json"
        },
        "ocr_with_table": {
          "function": "ocr_engine.ocr_with_table",
          "toolkit_command": "python ocr_engine.py ocr-table --file <path> --project <project>",
          "notes": "OCR所有文字+启发式表格行识别（连续多列数字行）"
        },
        "smart_auto": {
          "function": "doc_toolkit.read_pdf (mode=auto)",
          "toolkit_command": "python doc_toolkit.py read --file <path> --format pdf --mode auto --project <project>",
          "notes": "智能检测扫描件+自动OCR（推荐默认使用）"
        }
      },
      "read_text": {
        "function": "fitz.open",
        "example": "doc = fitz.open(path); for page in doc: text = page.get_text()",
        "toolkit_command": "python doc_toolkit.py read --file <path> --format pdf --mode text",
        "notes": "PyMuPDF读取速度最快，但扫描件返回空内容"
      },
      "read_table": {
        "function": "pdfplumber.open",
        "example": "with pdfplumber.open(path) as pdf: tables = pdf.pages[0].extract_tables()",
        "toolkit_command": "python doc_toolkit.py read --file <path> --format pdf --mode table"
      },
      "split": {
        "function": "pdf_splitter.py",
        "toolkit_command": "python pdf_splitter.py split --input <path> --pages <range> --output <dir>",
        "notes": "PDF拆分与合并资料整理工具"
      },
      "merge": {
        "function": "pdf_splitter.py",
        "toolkit_command": "python pdf_splitter.py merge --inputs <files> --output <merged.pdf>"
      },
      "extract_images": {
        "function": "pdf_splitter.py",
        "toolkit_command": "python pdf_splitter.py extract-images --input <path> --output <dir>"
      },
      "compress": {
        "function": "file_compressor.py (v2.1)",
        "toolkit_command": "python file_compressor.py compress --input <path> --type <material_type> --output <output>",
        "auto_command": "python file_compressor.py auto --input <path> --type <material_type> --output <output>",
        "quick_command": "python file_compressor.py compress --input <path> --type <material_type> --output <output> --quick",
        "check_command": "python file_compressor.py check --input <path> --type <material_type>",
        "list_limits": "python file_compressor.py list-limits",
        "notes": "v2.1优化版：自适应DPI计算+压缩有效性检测(deep<5%跳过extreme)+彩色优先策略(先扫彩色全DPI，超标再灰度)。实测18.17MB→3.84MB彩色(78.9%)，签章颜色保留。--quick直跳ultra",
        "strategies": {
          "light": "garbage=3 + deflate (2.7%压缩比)",
          "medium": "garbage=4 + clean content streams (2.7%压缩比)",
          "deep": "+ deflate_images + deflate_fonts (2.7%压缩比，扫描件无效)",
          "extreme_skip": "deep压缩比<5%时自动跳过extreme",
          "extreme": "+ page.clean_contents() + image recompress(q75→30) + JPEG2000→JPEG",
          "ultra_color_first": "彩色优先扫描(200→50共18级) → 找最高不超标DPI → 全线超标再降灰度"
        },
        "test_benchmark": {
          "file": "PS01_精密过滤器.pdf",
          "original": "18.17MB, 65页, 158图",
          "ultra_color_dpi95": "3.84MB (-78.9%, 达标, 签章颜色保留)",
          "ultra_color_dpi90": "3.48MB (-80.8%, 达标)",
          "ultra_gray_dpi100": "3.91MB (-78.5%, 备用方案)",
          "ultra_gray_dpi90": "3.28MB (-81.9%, 备用方案)"
        },
        "material_limits": {
          "IP": "≤2MB", "RD": "≤2MB", "PS": "≤4MB", "ACHIEVEMENT": "≤2MB",
          "STANDARD": "≤2MB", "LICENSE": "≤500KB", "COVER": "≤1MB",
          "AUDIT_FINANCIAL": "≤100MB", "AUDIT_RD": "≤100MB", "AUDIT_PS": "≤100MB",
          "TAX": "≤5MB", "MANAGEMENT": "≤20MB", "INSTITUTION": "≤20MB",
          "INCENTIVE": "≤5MB", "TRAINING": "≤5MB", "HR": "≤8MB",
          "CONTRACT": "≤20MB", "PROMISE": "≤1MB", "APPLICATION": "≤50MB"
        }
      },
      "extract_ps_baseline": {
        "function": "invoice_ps_matcher.py",
        "toolkit_command": "python invoice_ps_matcher.py --application-pdf <申请书.pdf> --invoices <发票.xlsx>",
        "notes": "从申请书提取PS基线（专用脚本）"
      },
      "common_scenarios": {
        "读取申请书内容": "doc_toolkit.py read --mode auto（推荐，自动识别扫描件）",
        "提取审计报告表格": "doc_toolkit.py read --mode table",
        "拆分多证书PDF": "pdf_splitter.py split",
        "合并多个PDF": "pdf_splitter.py merge",
        "从申请书提取PS": "invoice_ps_matcher.py（专用）",
        "扫描件PDF识别": "doc_toolkit.py read --mode auto（自动检测+OCR）",
        "扫描件强制OCR": "doc_toolkit.py read --mode ocr --force-ocr",
        "发票表格OCR": "ocr_engine.py ocr-table --file 发票.pdf",
        "合同字段提取": "contract_invoice_extractor.py extract --file 合同.pdf",
        "PDF压缩到申报要求": "file_compressor.py auto --type <材料类型>",
        "检查文件大小合规": "file_compressor.py check --type <材料类型>"
      }
    },

    ".jpg": { "description": "JPEG图像（营业执照扫描件）", "primary_library": "Pillow", "library_install": "pip install Pillow", "read": { "function": "PIL.Image.open", "example": "img = Image.open(path); print(img.size, img.mode)" }, "compress": { "function": "file_compressor.py", "toolkit_command": "python file_compressor.py compress --input <path> --type LICENSE --output <output>", "notes": "JPEG质量递减85→20+chroma4:2:0(参考Squoosh)→WebP转换(减小25-35%)。测试:227KB→96KB" } },
    ".png": { "description": "PNG图像", "primary_library": "Pillow", "library_install": "pip install Pillow", "read": { "function": "PIL.Image.open" }, "compress": { "function": "file_compressor.py", "toolkit_command": "python file_compressor.py compress --input <path> --max-size <size_mb> --output <output>", "notes": "PNG优化→量化256色(参考Caesium/pngquant)→转JPEG chroma4:2:0→转WebP" } },
    ".txt": { "description": "纯文本（提示词文件）", "primary_library": "标准库", "read": { "function": "open(path, 'r', encoding='utf-8')" } },
