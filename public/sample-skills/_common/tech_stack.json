      "library": "openpyxl + python-docx + pywin32",
      "command": "python audit_report_verifier.py --audit-pdf <报告.pdf> --core-tables <dir>",
      "validate": "python validate_audit_verification.py --dir <dir>"
    },
    "PDF拆分合并": {
      "primary": "pdf_splitter.py",
      "library": "PyPDF2 + pdfplumber + Pillow",
      "command": "python pdf_splitter.py split --input <path> --pages <range> --output <dir>"
    },
    "企微会话查询": {
      "primary": "wecom_query.py",
      "library": "pycryptodome + sqlite3",
      "command": "python wecom_query.py --action search --keyword <keyword>"
    },
    "Dify工作流生成RD立项书": {
      "primary": "dify_workflow.py",
      "library": "requests",
      "command": "python dify_workflow.py --action generate --rd-id <id> --count <n>"
    },
    "文件压缩（申报材料合规）": {
      "primary": "file_compressor.py",
      "library": "PyMuPDF + Pillow",
      "command": "python file_compressor.py auto --input <path> --type <材料类型> --output <output>",
      "check": "python file_compressor.py check --input <path> --type <材料类型>",
      "list_limits": "python file_compressor.py list-limits",
      "notes": "五级递进压缩。Ultra级支持9.7MB→1.7MB(82%压缩率)。图片支持WebP/PNG量化/chroma子采样"
    }
  },

  "anti_patterns": {
    "_comment": "禁止的低效模式，agent 不应尝试",
    "禁止从头创建xlsx": "必须用 generate_tables_from_template.py 从模板复制",
    "禁止用openpyxl读.doc": ".doc是二进制格式，openpyxl无法读取，必须先转换",
    "禁止用docx读.doc": "python-docx不支持.doc，必须用win32com转换或LibreOffice",
    "禁止手动解析PDF": "必须用PyMuPDF/pdfplumber，禁止逐字节解析",
    "禁止用requests下载本地文件": "本地文件用shutil.copy或open()读取",
    "禁止用json读取非json文件": "json.load只适用于.json文件",
    "禁止对扫描件返回空内容认为文件损坏": "扫描件需用 doc_toolkit.py read --mode auto 触发OCR",
    "禁止仅用text.strip()==''判定扫描件": "可能漏掉部分扫描件，应使用 doc_toolkit.py detect-scan 检测",
    "禁止重复OCR同一文件": "必须用 --project 参数指定项目，OCR结果自动缓存"
  }
}
