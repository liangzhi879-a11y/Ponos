    "@types/diff": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
