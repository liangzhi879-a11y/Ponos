{
  "name": "yfworking-gui",
  "version": "2.8.0",
  "description": "YFWorking GUI — A beautiful desktop interface for YFWorking with full feature parity",
  "author": "YFWorking",
  "main": "electron/main.cjs",
  "type": "module",
  "bin": {
    "yfworking": "./bin/cli.mjs"
  },
  "scripts": {
    "electron": "VITE_DEV_SERVER_URL=http://localhost:5197 electron .",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:electron": "npm run build && electron-builder",
    "build:electron:dir": "npm run build && electron-builder --dir",
    "test": "node --test --test-timeout=300000 \"shared/**/*.test.mjs\" \"server/*.test.mjs\" \"electron/*.test.mjs\" \"kernel-tests/*.test.mjs\" \"src/**/*.test.ts\" \"kit/**/*.test.mjs\"",
    "test:preflight": "node scripts/ci-preflight.mjs",
    "test:unit": "node --test --test-timeout=120000 \"shared/**/*.test.mjs\" \"electron/*.test.mjs\" \"src/**/*.test.ts\" \"kit/**/*.test.mjs\"",
    "test:server": "node --test --test-concurrency=4 --test-timeout=120000 \"server/*.test.mjs\"",
    "test:kernel": "node --test --test-concurrency=4 --test-timeout=120000 \"kernel-tests/*.test.mjs\"",
    "test:ci": "npm run test:preflight && node scripts/check-doc-anchors.mjs && npm run test:unit && npm run test:server && npm run test:kernel",
    "kit:check": "node kit/cli.mjs check",
    "kit:sync": "node kit/cli.mjs sync",
    "kit:view": "node kit/cli.mjs view --json",
    "kit:stamp": "node kit/cli.mjs stamp",
    "anchors:write": "node scripts/check-doc-anchors.mjs --write",
    "verify": "npm run typecheck && npm run test:ci"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-less": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sass": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.0",
    "classic-level": "^3.0.0",
    "clsx": "^2.1.0",
    "diff": "^7.0.0",
    "lucide-react": "^0.400.0",
    "mammoth": "^1.12.0",
    "nanoid": "^5.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^20",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
